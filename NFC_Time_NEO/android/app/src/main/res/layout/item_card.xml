<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tg_surface"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <!-- Circular Avatar -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_avatar">

            <TextView
                android:id="@+id/tvAvatarChar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="卡"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Main Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title & Status Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCardName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="手作卡片"
                    android:textColor="@color/tg_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="进行中"
                    android:textColor="@color/tg_status_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tags Row (智能豆板, 玩完再付/先付款, 预设套餐) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 智能豆板 Tag -->
                <TextView
                    android:id="@+id/tvTagDouban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#064E3B"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="📟 豆板"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- 玩完再付 (后付款) Tag -->
                <TextView
                    android:id="@+id/tvTagPostPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#881337"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="⚠️ 玩完再付"
                    android:textColor="#FB7185"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- 预设套餐 Tag -->
                <TextView
                    android:id="@+id/tvTagPreset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="#78350F"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="📦 1h套餐"
                    android:textColor="#FBBF24"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- 备注 Tag -->
                <TextView
                    android:id="@+id/tvRemarkBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#2B394A"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="📝 备注"
                    android:textColor="@color/tg_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- UID & Time Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCardUid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="UID: 04:A2:3B:11"
                    android:textColor="@color/tg_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvTimeDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="@color/tg_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Real-time Best Price / Pricing Breakdown Row -->
            <TextView
                android:id="@+id/tvCardPriceEstimate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="💰 预估: ¥12.9 (单人1小时套餐)"
                android:textColor="#FCD34D"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginStart="74dp"
        android:background="@color/tg_border" />

</LinearLayout>
