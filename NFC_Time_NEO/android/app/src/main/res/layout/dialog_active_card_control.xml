<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Title & Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActiveTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="手作制作中"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="进行中"
                android:textColor="#34D399"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvActiveUid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="UID: 04:A2:3B:11"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <!-- Big Real-time Clock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1C2733"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvActiveTimeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ 剩余时间"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvActiveRemainingBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="01:23:45"
                android:textColor="#34D399"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvActiveOverdueAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#881337"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="🚨 已超时: 00:12:00"
                android:textColor="#FB7185"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 智能豆板中途控制区 (可以中途开始使用智能豆板) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#16222F"
            android:orientation="vertical"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvActiveDoubanStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📟 智能豆板: 未使用"
                    android:textColor="#34D399"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnToggleActiveDouban"
                    style="@style/Widget.App.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="中途开启豆板"
                    android:textColor="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActiveDoubanTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="豆板已用时长: 00:00:00"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 调整开始时间区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1C2733"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvActiveStartTimeDisplay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🕒 开始时间: 14:00:00"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnAdjustStartTime"
                style="@style/Widget.App.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="🕒 调整时间"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- 价格计算明细卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#1C2733"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvActiveBestPlanTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💰 最优结算方案"
                    android:textColor="#FBBF24"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvActivePriceBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥ 0.0"
                    android:textColor="#FBBF24"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActiveFormula"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="计费计算明细..."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvActiveBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 自定义加时区 (输入分钟数，自由加时) -->
        <LinearLayout
            android:id="@+id/llAddDurationSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#16222F"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 自定义加时 (输入分钟数)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCustomAddMinutes"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_bg"
                    android:hint="输入加时分钟 (如: 15, 60)"
                    android:inputType="number"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnConfirmAddMinutes"
                    style="@style/Widget.App.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#0284C7"
                    android:text="➕ 确认加时"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main Timer Actions: Pause / Stop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnActivePause"
                style="@style/Widget.App.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="⏸️ 暂停"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnActiveStop"
                style="@style/Widget.App.Button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.3"
                android:backgroundTint="#EF4444"
                android:text="🛑 结算并重置"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
