<resources xmlns:app="http://schemas.android.com/apk/res-auto">
    <style name="Theme.NfcTimer" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#2AABEE</item>
        <item name="colorPrimaryVariant">#229ED9</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#2AABEE</item>
        <item name="android:windowBackground">@color/tg_background</item>
        <item name="android:statusBarColor">#17212B</item>
        <item name="android:navigationBarColor">#17212B</item>
        
        <item name="colorSurface">@color/tg_surface</item>
        <item name="colorOnSurface">@color/tg_text_primary</item>

        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.TextButton</item>
    </style>

    <!-- Primary Accent Button -->
    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="backgroundTint">#2AABEE</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Secondary Tonal Button -->
    <style name="Widget.App.Button.TonalButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="backgroundTint">#33455B</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">#485E78</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text / Cancel Button -->
    <style name="Widget.App.Button.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#90CAF9</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
    </style>
</resources>
