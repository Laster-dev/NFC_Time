<resources>
    <!-- Telegram Dark Theme -->
    <style name="Theme.NFCTime" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tg_blue</item>
        <item name="colorPrimaryVariant">@color/tg_blue_dark</item>
        <item name="colorOnPrimary">@color/tg_text_primary</item>
        <item name="colorSecondary">@color/tg_blue</item>
        <item name="android:windowBackground">@color/tg_background</item>
        <item name="android:statusBarColor">@color/tg_background</item>
        <item name="android:navigationBarColor">@color/tg_background</item>
        
        <!-- Telegram Dark Material Component Color Mapping -->
        <item name="colorSurface">@color/tg_surface</item>
        <item name="colorOnSurface">@color/tg_text_primary</item>
        <item name="colorSecondaryContainer">#2B394A</item>
        <item name="colorOnSecondaryContainer">@color/tg_blue</item>

        <!-- Fix Material Button Small Font and Auto-AllCaps -->
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.App.Button.TextButton</item>
    </style>

    <style name="Widget.App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="backgroundTint">@color/tg_blue</item>
    </style>

    <style name="Widget.App.Button.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/tg_blue</item>
    </style>

    <style name="Widget.App.Button.TonalButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">#2B394A</item>
        <item name="android:textColor">@color/tg_blue</item>
    </style>

    <style name="NumberPickerTheme">
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#B0C4DE</item>
        <item name="android:textColorSecondaryNoDisable">#B0C4DE</item>
    </style>
</resources>
