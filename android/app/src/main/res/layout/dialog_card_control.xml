<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="卡片设置 &amp; 计时详情"
        android:textColor="@color/tg_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dialogCardUid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="UID: 04:A2:3B"
        android:textColor="@color/tg_text_secondary"
        android:textSize="13sp" />

    <!-- Details Card Info (Shown when running/paused) -->
    <LinearLayout
        android:id="@+id/llTimelineDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@color/tg_background"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ 开始时间:"
                android:textColor="@color/tg_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStartTimeDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:textColor="@color/tg_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏁 预计到期:"
                android:textColor="@color/tg_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEndTimeDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:00"
                android:textColor="@color/tg_blue"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Name Input Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="卡片名称"
        android:textColor="@color/tg_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCardName"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@color/tg_background"
            android:hint="输入卡片名字"
            android:paddingHorizontal="14dp"
            android:textColor="@color/tg_text_primary"
            android:textColorHint="@color/tg_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnRename"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="重命名"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Remark Input Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="备注 (仅手机端可见)"
        android:textColor="@color/tg_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCardRemark"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@color/tg_background"
            android:hint="输入备注内容"
            android:paddingHorizontal="14dp"
            android:textColor="@color/tg_text_primary"
            android:textColorHint="@color/tg_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSaveRemark"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="保存"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnQuickUnpaid"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:backgroundTint="#FFE4E6"
            android:textColor="#E11D48"
            android:text="⚠️ 标记未付款"
            android:textSize="13sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/btnQuickClearRemark"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="#F1F5F9"
            android:textColor="#475569"
            android:text="🧹 清空备注"
            android:textSize="13sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Scrollable NumberPicker Section for Hours and Minutes -->
    <TextView
        android:id="@+id/tvPickerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="重设/修改倒计时时长"
        android:textColor="@color/tg_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/llPickerArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@color/tg_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <NumberPicker
            android:id="@+id/npHours"
            android:layout_width="wrap_content"
            android:layout_height="140dp"
            android:theme="@style/NumberPickerTheme" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:text="小时"
            android:textColor="@color/tg_blue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <NumberPicker
            android:id="@+id/npMinutes"
            android:layout_width="wrap_content"
            android:layout_height="140dp"
            android:theme="@style/NumberPickerTheme" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="分钟"
            android:textColor="@color/tg_blue"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tg_status_green"
            android:text="开始/重置"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/tg_status_orange"
            android:text="暂停"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/tg_text_secondary"
            android:text="停止"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Delete Card Button -->
    <Button
        android:id="@+id/btnDeleteCard"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="🗑️ 清理/设为未使用状态"
        android:textColor="@color/tg_status_red"
        android:textSize="15sp"
        android:textStyle="bold"
        app:strokeColor="@color/tg_status_red" />

</LinearLayout>
