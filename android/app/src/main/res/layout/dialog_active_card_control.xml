<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_rounded_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header for Active Card Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvActiveTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="卡片计时详情"
            android:textColor="@color/tg_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActiveStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#3345B880"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="进行中"
            android:textColor="@color/tg_status_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvActiveUid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:text="UID: 04:A2:3B"
        android:textColor="@color/tg_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvActiveRemark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📝 备注: 无"
            android:textColor="@color/tg_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnActiveQuickUnpaid"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#FFE4E6"
            android:textColor="#E11D48"
            android:text="⚠️ 标记未付款"
            android:textSize="12sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp" />

        <Button
            android:id="@+id/btnActiveQuickClear"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#F1F5F9"
            android:textColor="#475569"
            android:text="🧹 清空"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp" />
    </LinearLayout>

    <!-- Big Digital Clock & Overdue Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tg_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvActiveTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩余时间"
            android:textColor="@color/tg_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvActiveRemainingBig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:text="15分钟30秒"
            android:textColor="@color/tg_status_green"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Overdue text line (Visible only when overdue) -->
        <TextView
            android:id="@+id/tvActiveOverdueAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 已超时 5分钟12秒"
            android:textColor="@color/tg_status_red"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Price Calculation Box (Live estimated price & best scheme) -->
    <LinearLayout
        android:id="@+id/llPriceCardArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#242F3D"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💰 实时预估价格 (最划算):"
                android:textColor="#FCD34D"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstimatedPriceBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥ 12.9"
                android:textColor="#FCD34D"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBestPlanName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="💡 推荐方案: 单人1小时套餐"
            android:textColor="@color/tg_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPriceBreakdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="明细: 基础¥12.9"
            android:textColor="@color/tg_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDoubleModeBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👥 当前: 单人计费"
                android:textColor="@color/tg_blue"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnToggleDoubleMode"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="切换为双人计费"
                android:textSize="11sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Timeline Details Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tg_background"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Line 1: Start Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▶ 开始时间:"
                android:textColor="@color/tg_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvActiveStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30:00"
                android:textColor="@color/tg_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Line 2: Estimated End Time (Countdown only) -->
        <LinearLayout
            android:id="@+id/llActiveEndTimeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏁 预计到期:"
                android:textColor="@color/tg_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvActiveEndTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15:00:00"
                android:textColor="@color/tg_blue"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Line 3: Target/Set Duration -->
        <LinearLayout
            android:id="@+id/llActiveTargetDurationRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏱️ 设定时长:"
                android:textColor="@color/tg_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvActiveTargetDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30分钟"
                android:textColor="@color/tg_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Countdown Quick Add Time Buttons Section (Countdown only) -->
    <LinearLayout
        android:id="@+id/llCountdownAddSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="⚡ 快捷加时"
            android:textColor="@color/tg_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdd10Min"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#2B394A"
                android:textColor="@color/tg_blue"
                android:text="+10分钟"
                android:textSize="14sp"
                android:textStyle="bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp" />

        <Button
            android:id="@+id/btnAdd30Min"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#2B394A"
            android:textColor="@color/tg_blue"
            android:text="+30分钟"
            android:textSize="14sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/btnAdd1Hour"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#2B394A"
            android:textColor="@color/tg_blue"
            android:text="+1小时"
            android:textSize="14sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp" />
    </LinearLayout>

    <!-- Custom Add Time Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="✍️ 自定义加时"
        android:textColor="@color/tg_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCustomAddMinutes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/tg_background"
            android:hint="输入分钟数"
            android:inputType="number"
            android:paddingHorizontal="14dp"
            android:textColor="@color/tg_text_primary"
            android:textColorHint="@color/tg_text_secondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCustomAddConfirm"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/tg_blue"
            android:textColor="#FFFFFF"
            android:text="确认加时"
            android:textSize="14sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>
    </LinearLayout>

    <!-- Main Control Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnActivePause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tg_status_orange"
            android:text="暂停"
            android:textSize="15sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <Button
            android:id="@+id/btnActiveStop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/tg_status_red"
            android:text="停止计时"
            android:textSize="15sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</LinearLayout>
