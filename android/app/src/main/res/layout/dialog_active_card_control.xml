<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/tg_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header for Active Card Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvActiveTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="卡片计时详情"
            android:textColor="@color/tg_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActiveStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#3345B880"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="进行中"
            android:textColor="@color/tg_status_green"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvActiveUid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp"
        android:text="UID: 04:A2:3B"
        android:textColor="@color/tg_text_secondary"
        android:textSize="13sp" />

    <!-- Big Digital Clock & Overdue Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tg_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvActiveTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩余时间"
            android:textColor="@color/tg_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvActiveRemainingBig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:text="00:25:30"
            android:textColor="@color/tg_status_green"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Overdue text line (Visible only when overdue) -->
        <TextView
            android:id="@+id/tvActiveOverdueAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 已超时 00:05:12"
            android:textColor="@color/tg_status_red"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Start Time Line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@color/tg_background"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ 开始时间:"
            android:textColor="@color/tg_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvActiveStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:30:00"
            android:textColor="@color/tg_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Add Time Buttons Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="⚡ 快捷加时"
        android:textColor="@color/tg_text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAdd10Min"
            style="@style/Widget.App.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="+10分钟" />

        <Button
            android:id="@+id/btnAdd30Min"
            style="@style/Widget.App.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="+30分钟" />

        <Button
            android:id="@+id/btnAdd1Hour"
            style="@style/Widget.App.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="+1小时" />
    </LinearLayout>

    <!-- Main Control Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnActivePause"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="@color/tg_status_orange"
            android:text="暂停"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnActiveStop"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/tg_status_red"
            android:text="停止计时"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
